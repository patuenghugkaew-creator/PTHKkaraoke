           <property name="text">
            <string>รูปแบบกราฟการเฟดเสียง (Crossfade Curve) :</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QComboBox" name="comboCrossfadeCurve">
           <item>
            <property name="text">
             <string>Equal-Power Cosine (พลังงานคงที่ ไม่ดร็อปช่วงกลาง)</string>
