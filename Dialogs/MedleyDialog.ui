  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: #0d1117;
    color: #e6edf3;
    font-size: 10pt;
}
QLabel {
    color: #e6edf3;
}
QGroupBox {
    border: 1px solid #30363d;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 16px;
    font-weight: bold;
    color: #58a6ff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    background-color: #161b22;
}
QTabWidget::pane {
    border: 1px solid #30363d;
    border-radius: 8px;
    background-color: #161b22;
}
QTabBar::tab {
    background-color: #0d1117;
    color: #8b949e;
    padding: 6px 14px;
    font-size: 9.5pt;
    font-weight: bold;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
}
QTabBar::tab:selected {
    background-color: #161b22;
    color: #58a6ff;
    border: 1px solid #30363d;
    border-bottom: none;
}
QTabBar::tab:hover:!selected {
    background-color: #21262d;
    color: #c9d1d9;
}
QComboBox {
    background-color: #21262d;
    color: #f0f6fc;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 26px;
}
QComboBox:focus, QComboBox:hover {
    border: 1px solid #58a6ff;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border-left: 1px solid #30363d;
}
QComboBox QAbstractItemView, QComboBox QListView {
    background-color: #161b22;
    color: #f0f6fc;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}
QComboBox QAbstractItemView::item, QComboBox QListView::item {
    color: #f0f6fc;
    background-color: #161b22;
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 4px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #21262d;
    color: #58a6ff;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}
QSpinBox, QDoubleSpinBox {
    background-color: #21262d;
    color: #58a6ff;
    font-weight: bold;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 3px 6px;
    min-height: 26px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #58a6ff;
    background-color: #161b22;
}
QSlider::groove:horizontal {
    height: 6px;
    background: #30363d;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #1f6feb;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #58a6ff;
    border: 2px solid #ffffff;
    width: 16px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #79c0ff;
}
QCheckBox {
    color: #e6edf3;
    spacing: 8px;
    font-size: 10pt;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #484f58;
    border-radius: 4px;
    background-color: #21262d;
}
QCheckBox::indicator:hover {
    border: 1px solid #58a6ff;
}
QCheckBox::indicator:checked {
    background-color: #1f6feb;
    border: 1px solid #58a6ff;
}
QPushButton {
    background-color: #1f6feb;
    color: #ffffff;
    border-radius: 6px;
    padding: 6px 18px;
    font-weight: bold;
    border: 1px solid #388bfd;
}
QPushButton:hover {
    background-color: #388bfd;
}
QPushButton#btnReset {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
}
QPushButton#btnReset:hover {
    background-color: #30363d;
    color: #f0f6fc;
}
QPushButton#btnCancel {
    background-color: #30363d;
    color: #f0f6fc;
    border: 1px solid #484f58;
}
QPushButton#btnCancel:hover {
    background-color: #484f58;
}
QPushButton[quickBtn="true"] {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 3px 7px;
    font-size: 9pt;
    font-weight: normal;
    min-height: 20px;
}
QPushButton[quickBtn="true"]:hover {
    background-color: #30363d;
    color: #58a6ff;
    border: 1px solid #58a6ff;
}
QPushButton[quickBtn="true"]:pressed {
    background-color: #1f6feb;
    color: #ffffff;
}
</string>
