<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MedleyDialog</class>
 <widget class="QDialog" name="MedleyDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>700</width>
    <height>580</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>680</width>
    <height>560</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>ตั้งค่าระบบเมดเล่ย์ (Medley Studio)</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: #0d1117;
    color: #e6edf3;
    font-size: 11pt;
}
QLabel {
    color: #e6edf3;
}
QTabWidget::pane {
    border: 1px solid #30363d;
    border-radius: 8px;
    background-color: #161b22;
}
QTabBar::tab {
    background-color: #0d1117;
    color: #8b949e;
    padding: 9px 18px;
    font-weight: bold;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 3px;
    min-width: 150px;
}
QTabBar::tab:selected {
    background-color: #161b22;
    color: #58a6ff;
    border: 1px solid #30363d;
    border-bottom: none;
}
QTabBar::tab:hover:!selected {
    background-color: #21262d;
    color: #c9d1d9;
}
QComboBox {
    background-color: #21262d;
    color: #f0f6fc;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 5px 10px;
    min-height: 26px;
}
QComboBox:focus, QComboBox:hover {
    border: 1px solid #58a6ff;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border-left: 1px solid #30363d;
}
QComboBox QAbstractItemView {
    background-color: #161b22;
    color: #f0f6fc;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 4px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #21262d;
    color: #58a6ff;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}
QSpinBox, QDoubleSpinBox {
    background-color: #21262d;
    color: #f0f6fc;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 26px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #58a6ff;
}
QSlider::groove:horizontal {
    height: 6px;
    background: #30363d;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #1f6feb;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #58a6ff;
    border: 2px solid #ffffff;
    width: 16px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #79c0ff;
}
QCheckBox {
    color: #e6edf3;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #484f58;
    border-radius: 4px;
    background-color: #21262d;
}
QCheckBox::indicator:hover {
    border: 1px solid #58a6ff;
}
QCheckBox::indicator:checked {
    background-color: #1f6feb;
    border: 1px solid #58a6ff;
}
QPushButton {
    background-color: #1f6feb;
    color: #ffffff;
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: bold;
    border: 1px solid #388bfd;
}
QPushButton:hover {
    background-color: #388bfd;
}
QPushButton#btnReset {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
}
QPushButton#btnReset:hover {
    background-color: #30363d;
    color: #f0f6fc;
}
QPushButton#btnCancel {
    background-color: #30363d;
    color: #f0f6fc;
    border: 1px solid #484f58;
}
QPushButton#btnCancel:hover {
    background-color: #484f58;
}
</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing">
    <number>12</number>
   </property>
   <property name="leftMargin">
    <number>14</number>
   </property>
   <property name="topMargin">
    <number>14</number>
   </property>
   <property name="rightMargin">
    <number>14</number>
   </property>
   <property name="bottomMargin">
    <number>14</number>
   </property>
   <item>
    <layout class="QHBoxLayout" name="headerLayout">
     <property name="spacing">
      <number>10</number>
     </property>
     <item>
      <widget class="QLabel" name="labelPreset">
       <property name="font">
        <font>
         <bold>true</bold>
        </font>
       </property>
       <property name="text">
        <string>พรีเซ็ตด่วน (Presets) :</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="comboPreset">
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
         <horstretch>0</horstretch>
         <verstretch>0</verstretch>
        </sizepolicy>
       </property>
       <item>
        <property name="text">
         <string>🎉 ปาร์ตี้ / วาไรตี้ (Party &amp;&amp; Variety) - ต่อเร็ว กระชับ สนุกสนาน</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>🍷 ฟังสบาย / ร้านอาหาร (Restaurant &amp;&amp; Lounge) - เฟดนุ่มนวล</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>🎸 แสดงสด / ไลฟ์แบนด์ (Live Band) - ล็อกห้องเป๊ะ ส่งกลองเต็ม</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>⚙ กำหนดเอง (Custom)</string>
        </property>
       </item>
      </widget>
     </item>
    </layout>
   </item>
   <item>
